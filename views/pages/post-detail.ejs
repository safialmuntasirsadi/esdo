<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/meta') %>
</head>
<body>
    <%- include('../partials/nav') %>

    <!-- Post Hero -->
    <header class="post-hero">
        <img class="post-hero__img" src="<%= post.image.replace('w=600&h=300&fit=crop', 'w=1600&h=800&fit=crop') %>" alt="<%= post.title %>" loading="eager">
        <div class="post-hero__content">
            <div class="post-hero__inner">
                <a href="/blog" class="post-hero__back-link">&larr; Back to Blog</a>
                <span class="post-hero__category"><%= post.category %></span>
                <h1 class="post-hero__title"><%= post.title %></h1>
                <p class="post-hero__excerpt"><%= post.excerpt %></p>
                <div class="post-hero__meta">
                    <span>By <%= post.author %></span>
                    <span><%= post.date %></span>
                    <span><%= post.readTime %> read</span>
                </div>
            </div>
        </div>
    </header>

    <!-- Reading Progress Bar -->
    <div class="reading-progress"><div class="reading-progress__fill"></div></div>

    <!-- Content -->
    <article class="article-layout">
        <div class="container">
            <div class="post-content">

                <!-- Mobile meta bar: tags -->
                <% if (post.tags && post.tags.length > 0) { %>
                <div class="post-meta-bar">
                    <% post.tags.forEach(tag => { %>
                        <a href="/blog?search=<%= encodeURIComponent(tag) %>" class="post-meta-bar__tag">#<%= tag %></a>
                    <% }) %>
                </div>
                <% } %>

                <% post.sections.forEach(section => { %>
                    <% if (section.type === 'lead') { %>
                        <p class="post-content__lead"><%= section.content %></p>
                    <% } else if (section.type === 'paragraph') { %>
                        <p><%= section.content %></p>
                    <% } else if (section.type === 'heading') { %>
                        <h2><%= section.content %></h2>
                    <% } else if (section.type === 'pillars') { %>
                        <div class="post-pillars">
                            <h3 class="post-pillars__title"><%= section.title %></h3>
                            <% section.items.forEach((item, i) => { %>
                            <div class="pillar-item">
                                <div class="pillar-item__num"><%= i + 1 %></div>
                                <div class="pillar-item__text">
                                    <span class="pillar-item__label"><%= item.label %>:</span> <%= item.text %>
                                </div>
                            </div>
                            <% }) %>
                        </div>
                    <% } else if (section.type === 'comparison') { %>
                        <div class="post-comparison">
                            <div class="post-comparison__scroll">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>Aspect</th>
                                            <th>Mass Tourism</th>
                                            <th>Eco Tourism</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% section.items.forEach(row => { %>
                                        <tr>
                                            <td data-label="Aspect"><strong><%= row[0] %></strong></td>
                                            <td data-label="Mass Tourism"><%= row[1] %></td>
                                            <td data-label="Eco Tourism"><%= row[2] %></td>
                                        </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    <% } else if (section.type === 'steps') { %>
                        <div class="post-steps">
                            <% section.items.forEach(item => { %>
                            <div class="post-step">
                                <div class="post-step__icon"><%= item.icon %></div>
                                <div>
                                    <h3 class="post-step__title"><%= item.title %></h3>
                                    <p class="post-step__text"><%= item.text %></p>
                                </div>
                            </div>
                            <% }) %>
                        </div>
                    <% } else if (section.type === 'image') { %>
                        <div class="post-image">
                            <img src="<%= section.src %>" alt="<%= section.alt %>" loading="lazy">
                            <% if (section.caption) { %>
                            <p class="post-image__caption"><%= section.caption %></p>
                            <% } %>
                        </div>
                    <% } else if (section.type === 'image-grid') { %>
                        <div class="post-image-grid">
                            <% section.images.forEach(img => { %>
                            <div class="post-image-grid__item">
                                <img src="<%= img.src %>" alt="<%= img.alt %>" loading="lazy">
                                <% if (img.caption) { %>
                                <p class="post-image__caption"><%= img.caption %></p>
                                <% } %>
                            </div>
                            <% }) %>
                        </div>
                    <% } else if (section.type === 'callout') { %>
                        <div class="callout-box">
                            <p><%= section.content %></p>
                            <% if (section.source) { %>
                            <span class="callout-box__source"><%= section.source %></span>
                            <% } %>
                        </div>
                    <% } else if (section.type === 'quote') { %>
                        <div class="post-quote">
                            <blockquote><%= section.content %></blockquote>
                            <% if (section.author) { %>
                            <cite><%= section.author %></cite>
                            <% } %>
                        </div>
                    <% } else if (section.type === 'list') { %>
                        <ul class="post-list">
                            <% section.items.forEach(item => { %>
                            <li><strong><%= item.title %></strong> — <%= item.text %></li>
                            <% }) %>
                        </ul>
                    <% } else if (section.type === 'stats-grid') { %>
                        <div class="stats-grid">
                            <% section.items.forEach(item => { %>
                            <div class="stat-item">
                                <span class="stat-item__number"><%= item.number %></span>
                                <span class="stat-item__label"><%= item.label %></span>
                                <% if (item.sublabel) { %>
                                <span class="stat-item__sublabel"><%= item.sublabel %></span>
                                <% } %>
                            </div>
                            <% }) %>
                        </div>
                    <% } else if (section.type === 'feature-grid') { %>
                        <div class="feature-grid">
                            <% section.items.forEach(item => { %>
                            <div class="feature-card">
                                <div class="feature-card__icon"><%= item.icon %></div>
                                <h3 class="feature-card__title"><%= item.title %></h3>
                                <p class="feature-card__text"><%= item.text %></p>
                            </div>
                            <% }) %>
                        </div>
                    <% } else if (section.type === 'data-bar') { %>
                        <div class="data-bar-section">
                            <% if (section.title) { %><h3 class="data-bar-section__title"><%= section.title %></h3><% } %>
                            <div class="data-bars">
                                <% section.items.forEach(item => { %>
                                <div class="data-bar-item">
                                    <div class="data-bar-header">
                                        <span class="data-bar-label"><%= item.label %></span>
                                        <span class="data-bar-value"><%= item.value %></span>
                                    </div>
                                    <div class="data-bar-track">
                                        <div class="data-bar-fill" data-animate="true" data-width="<%= item.percent %>" style="background: var(--<%= item.color || 'primary' %>);"></div>
                                    </div>
                                </div>
                                <% }) %>
                            </div>
                            <% if (section.source) { %>
                            <p class="chart-source"><%= section.source %></p>
                            <% } %>
                        </div>
                    <% } %>
                <% }) %>

                <!-- CTA -->
                <div class="post-cta">
                    <h3>Ready to Experience Eco Tourism in Bangladesh?</h3>
                    <p>Explore ESDO's eco-tourism destinations and plan your first sustainable trip.</p>
                    <a href="/destinations" class="btn btn-white">Explore Destinations</a>
                </div>

                <!-- Related Posts -->
                <% if (related.length > 0) { %>
                <div class="related-posts">
                    <h3>Related Articles</h3>
                    <div class="blog-grid">
                        <% related.forEach(p => { %>
                            <%- include('../components/blog-card', { post: p }) %>
                        <% }) %>
                    </div>
                </div>
                <% } %>
            </div>

            <!-- Sidebar (desktop only) -->
            <aside class="article-sidebar">
                <div class="sidebar-widget">
                    <h3>Article Info</h3>
                    <div class="quick-fact"><span class="fact-number"><%= post.category %></span><span class="fact-text">category</span></div>
                    <div class="quick-fact"><span class="fact-number"><%= post.readTime %></span><span class="fact-text">read time</span></div>
                    <div class="quick-fact"><span class="fact-number"><%= post.date %></span><span class="fact-text">published</span></div>
                </div>
                <div class="sidebar-widget">
                    <h3>More Articles</h3>
                    <% posts.filter(p => p.slug !== post.slug).slice(0, 3).forEach(p => { %>
                    <p class="related-post"><a href="/blog/<%= p.slug %>"><%= p.title %></a></p>
                    <% }) %>
                </div>
            </aside>
        </div>
    </article>

    <%- include('../partials/footer') %>
    <%- include('../partials/scripts') %>
</body>
</html>
